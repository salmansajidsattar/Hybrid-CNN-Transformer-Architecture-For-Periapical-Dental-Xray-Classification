# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging / tooling caches
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ─── Virtual environments ────────────────────────────────────────────────────
env/
venv/
.venv/
ENV/

# ─── IDE / editor / OS junk ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Project: dataset (never commit — pulled from Mendeley / Kaggle) ─────────
data/
data/raw/
data/processed/

# ─── Project: trained-model artifacts (regenerated by run_seeds.py) ──────────
checkpoints/
*.pth
*.pt
*.onnx
model.onnx
model.onnx/

# RadImageNet pretrained weights — ~120 MB, downloadable from Mount Sinai
# https://github.com/BMEII-AI/RadImageNet (converted to .pt by third-party port)
RadImageNet_pytorch/
RadImageNet*/
*ResNet50.pt
*DenseNet121.pt

# ─── Project: training outputs (regenerated every run) ───────────────────────
logs/
results/
runs/
tb_logs/
img/
figures/

# ─── Project: paper working files (keep LOCAL only) ──────────────────────────
researchpaper/
Research Paper/
"Research Paper"/

# LaTeX build byproducts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lot
*.lof
*.pdf

# LaTeX draft backups (keep main.tex, drop timestamped backups)
main.tex.bak*
*.tex.bak*

# ─── Project: non-code deliverables (not needed at runtime) ──────────────────
# PowerPoint / Word / design files — slides, defence decks, Word drafts
*.pptx
*.ppt
*.docx
*.doc
*.odp
*.odt

# Drawio diagrams and their autosaves (keep README / .md docs though)
*.drawio
*.drawio.bkp
*.drawio.dtmp
.$*.drawio.dtmp
.$*

# Archives (never check in — repo should be reproducible from source)
*.rar
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Office auto-save / lock files
~$*
*.tmp
*.bak

# ─── Project: Kaggle staging + nested duplicates ─────────────────────────────
# kaggle_upload/ is a staging folder for uploading to Kaggle datasets — just a
# flattened copy of src/, not an independent source tree.
kaggle_upload/

# A nested duplicate of the project tree accidentally created in May 2026 —
# NOT the real codebase. Real sources are in src/ at the repo root.
Dental_Xray_Classification/

# ─── Project: design-asset sources (keep LOCAL, not needed at runtime) ───────
# Architecture_diagram/ holds the drawio sources for the paper figures. The
# rendered PNGs that main.tex references live in figures/ (also ignored).
# If you want the drawio sources version-controlled, comment the next line.
Architecture_diagram/

# ─── Project: test fixtures / sample data (regenerable; may be very large) ───
# test/ is a sample-data staging dir (raw/, processed/), not a code test
# suite. The real sources are under src/.
test/

# ─── Project: one-shot patch scripts (optional; comment out to keep) ─────────
# These are scaffolding scripts I used to apply the main-tex / model_v2 /
# train_v2 edits across sessions. They are not imported by any runtime code.
# If you want to keep them in git for history, comment the next block out.
patch_*.py

# ─── Project: stray leftover artefacts from older sessions ───────────────────
# File-system sync tests written during the earlier mount debugging --
# none are runtime inputs; delete locally once comfortable.
_synctest.txt
main_updated_test.tex

# Bare-name legacy drafts of the architecture description — superseded by
# the current src/model_v2.py and main.tex. If you still refer to them,
# comment the next two lines out.
cnn_transformer_architecture
hybrid_cnn_transformer

# A root-level duplicate of src/train_v2.py from an earlier mount sync
# accident. The authoritative file is src/train_v2.py; this root copy is
# stale and should not be pushed.
/train_v2.py

# ─── Secrets / credentials (NEVER commit) ────────────────────────────────────
*.env
.env.local
.env.*.local
*.key
*.pem
secrets.yaml
kaggle.json
